#
# CLI tools. These few are uncontroversial and safe on any Mac, so they ship
# enabled — `brew bundle` does something useful out of the box.
#
brew "gh"              # GitHub CLI — repos, PRs, issues
brew "jq"              # JSON processing in the terminal
brew "tree"            # Visualise directory structures

